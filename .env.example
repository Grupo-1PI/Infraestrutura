# Copie para .env e preencha os valores locais. Nunca versione o arquivo .env.
DB_NAME=taotenshin
DB_USERNAME=taotenshin
DB_PASSWORD=troque-por-uma-senha-local
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-local
JWT_SECRET=troque-por-um-segredo-local-com-pelo-menos-32-bytes

FRONTEND_IMAGE=allyawada/tao-tenshin_front-end:latest
BACKEND_IMAGE=allyawada/tao-tenshin_back-end:latest
FILAMQ_IMAGE=allyawada/tao-tenshin_rabbitmq:latest

# Twilio fica desabilitado para testes locais sem envio de mensagens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_CONTENT_SID=

DATABASE_INIT_SQL_URL=https://raw.githubusercontent.com/Grupo-1PI/Banco-de-dados/refs/heads/production/script_completo.sql
