#!/bin/bash
set -euo pipefail

apt-get update -y
apt-get install -y ca-certificates curl gnupg lsb-release
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg --yes
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo \"$VERSION_CODENAME\") stable" >/etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y awscli docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

aws ecr get-login-password --region '${aws_region}' | docker login --username AWS --password-stdin '${ecr_registry}'

# Create user-defined network for container DNS resolution
docker network create taotenshin-network || true

DB_PASSWORD="$(printf '%s' '${db_password_b64}' | base64 --decode)"
JWT_SECRET="$(printf '%s' '${jwt_secret_b64}' | base64 --decode)"

%{ if initialize_database ~}
# O RDS e criado antes desta instancia. O loop absorve o curto periodo ate ele
# aceitar conexoes e aplica o SQL raw somente uma vez, no backend-1.
for attempt in $(seq 1 30); do
  if docker run --rm --network host -e MYSQL_PWD="$$DB_PASSWORD" mysql:8.0 \
    mysqladmin ping -h '${db_host}' -u '${db_username}' --silent; then
    curl -fsSL '${database_init_sql_url}' | docker run --rm -i --network host \
      -e MYSQL_PWD="$DB_PASSWORD" mysql:8.0 \
      mysql -h '${db_host}' -u '${db_username}' '${db_name}'
    break
  fi

  if [ "$attempt" -eq 30 ]; then
    echo "RDS nao ficou disponivel a tempo para a inicializacao." >&2
    exit 1
  fi
  sleep 10
done
%{ endif ~}

# --- RabbitMQ (mesma instancia) ---
docker rm -f taotenshin-rabbitmq || true
docker run -d --restart unless-stopped --name taotenshin-rabbitmq \
  --network taotenshin-network \
  -p 5672:5672 -p 15672:15672 \
  -e RABBITMQ_DEFAULT_USER=guest \
  -e RABBITMQ_DEFAULT_PASS=guest \
  rabbitmq:4-management

# Aguardar RabbitMQ ficar pronto
for attempt in $(seq 1 30); do
  if docker exec taotenshin-rabbitmq rabbitmq-diagnostics -q ping 2>/dev/null; then
    break
  fi
  if [ "$attempt" -eq 30 ]; then
    echo "RabbitMQ nao ficou disponivel a tempo." >&2
    exit 1
  fi
  sleep 3
done

# --- filaMQ (Notificacoes RabbitMQ + Twilio) ---
docker pull '${filamq_image}'
docker rm -f taotenshin-filamq || true
docker run -d --restart unless-stopped --name taotenshin-filamq \
  --network taotenshin-network \
  -p 8081:8081 \
  -e SPRING_PROFILES_ACTIVE=docker \
  -e SERVER_PORT=8081 \
  -e SPRING_RABBITMQ_HOST=taotenshin-rabbitmq \
  -e SPRING_RABBITMQ_PORT=5672 \
  -e SPRING_RABBITMQ_USERNAME=guest \
  -e SPRING_RABBITMQ_PASSWORD=guest \
  -e TWILIO_ACCOUNT_SID="${twilio_account_sid}" \
  -e TWILIO_AUTH_TOKEN="${twilio_auth_token}" \
  -e TWILIO_PHONE_NUMBER="${twilio_phone_number}" \
  -e TWILIO_CONTENT_SID="${twilio_content_sid}" \
  '${filamq_image}'

# --- Backend ---
docker pull '${backend_image}'
docker rm -f taotenshin-backend || true
docker run -d --restart unless-stopped --name taotenshin-backend \
  --network taotenshin-network \
  -p 8080:8080 \
  -e SERVER_PORT=8080 \
  -e SERVER_SERVLET_CONTEXT_PATH=/api \
  -e NOTIFICACAO_SAAS_URL="http://taotenshin-filamq:8081" \
  -e DB_URL='jdbc:mysql://${db_host}:3306/${db_name}' \
  -e DB_USERNAME='${db_username}' \
  -e DB_PASSWORD="$DB_PASSWORD" \
  -e JWT_SECRET="$JWT_SECRET" \
  -e SPRING_DATASOURCE_URL="jdbc:mysql://${db_host}:3306/${db_name}" \
  -e SPRING_DATASOURCE_USERNAME="${db_username}" \
  -e SPRING_DATASOURCE_PASSWORD="$DB_PASSWORD" \
  -e JPA_DDL_AUTO=none \
  -e SQL_INIT_MODE=never \
  '${backend_image}'
